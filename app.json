{
  "expo": {
    "name": "هادي",
    "slug": "هادي",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hadi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expertGroup.hadi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.expertGroup.hadi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#091115"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Cairo-Regular.ttf",
            "./assets/fonts/Cairo-Medium.ttf",
            "./assets/fonts/Cairo-SemiBold.ttf",
            "./assets/fonts/Cairo-Bold.ttf",
            "./assets/fonts/Cairo-Light.ttf",
            "./assets/fonts/Cairo-Black.ttf",
            "./assets/fonts/Cairo-ExtraBold.ttf",
            "./assets/fonts/Cairo-ExtraLight.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de5235fd-fd75-455d-8457-df69bb56a0d0"
      }
    },
    "owner": "ghithaa"
  }
}
